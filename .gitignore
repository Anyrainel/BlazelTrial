# Runtime state is tracked on purpose so reviewers see the exact state (DB, docs, logs).
# Only machine-local / regenerable pieces are excluded.
.state/models/
.state/scenarios/
.state/logs/*.png
.state/*.pid
.state/**/*-shm
.state/**/*-wal
!.state/backups/**/*-wal

# Secrets
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
dist/
build/

# Web
web/node_modules/
web/dist/

# OS / editors
.DS_Store
Thumbs.db
.vscode/
.idea/
web/*.tsbuildinfo
