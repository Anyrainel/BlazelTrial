# Which model backend to use: anthropic | meta | local
LLM_PROVIDER=local
LLM_MODEL=bonsai-2-27b
# Used when the local model can't be reached or started (checked once per process); none = fail
LLM_FALLBACK_PROVIDER=anthropic
LLM_FALLBACK_MODEL=claude-sonnet-5-5

# Anthropic (Claude Sonnet 5.5): LLM_PROVIDER=anthropic, LLM_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=

# Meta (Muse Spark 1.3 Contributor): LLM_PROVIDER=meta, LLM_MODEL=muse-spark-1.3-contributor
META_API_KEY=

# Local llama.cpp server (Bonsai 2): LLM_PROVIDER=local, LLM_MODEL=bonsai-2-27b (served name).
# Started automatically on first use if nothing answers on LOCAL_BASE_URL; needs PrismML's
# llama.cpp fork. Manage by hand with `uv run chatbot local-server start|stop|status`.
LOCAL_BASE_URL=http://localhost:11434/v1
LOCAL_SERVER_BIN=F:\Codes\models\llama.cpp\win-cuda-13.3-prism-b10787\llama-server.exe
LOCAL_MODEL_PATH=F:\Codes\models\Bonsai\Ternary-Bonsai-2-27B-PQ2_0.gguf
# LOCAL_AUTOSTART=true
# LOCAL_REASONING=auto   # on | off | auto (thinking)
# LOCAL_REASONING_EFFORT=low   # default | low | medium | xhigh (template default is xhigh)

# Hard input-token budget per model request
MAX_INPUT_TOKENS=8000

# Context and memory maintenance (turn counts)
HISTORY_TOKEN_BUDGET=2500
HISTORY_WINDOW_STEP=8
SUMMARY_CHUNK_TURNS=25
SUMMARY_KEEP_RECENT_TURNS=16
# soft: flag the chat message (history kept) and delete derived memory; hard: also delete messages
MEMORY_FORGET_MODE=soft

# Runtime state (DB, generated docs, logs, model cache)
STATE_DIR=.state

# Slack (Socket Mode)
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
# Optional user token (not used by the basic DM integration)
SLACK_USER_TOKEN=
