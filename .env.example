# Which model backend to use: anthropic | meta | local
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5-5

# Anthropic (Claude Sonnet 5.5)
ANTHROPIC_API_KEY=

# Meta (Muse Spark 1.3 Contributor): LLM_PROVIDER=meta, LLM_MODEL=muse-spark-1.3-contributor
META_API_KEY=

# Local OpenAI-compatible server (Bonsai 2) - set LLM_MODEL to the local model name
LOCAL_BASE_URL=http://localhost:11434/v1

# Hard input-token budget per model request
MAX_INPUT_TOKENS=8000

# Runtime state (DB, generated docs, logs, model cache)
STATE_DIR=.state

# Slack (Socket Mode)
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
